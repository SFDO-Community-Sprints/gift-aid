<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Populate_Gone_Away_Date</name>
        <label>Populate Gone Away Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.AddressGoneAwayDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>End_Active_GA_Periods</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Remove_Gone_Away_Date</name>
        <label>Remove Gone Away Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.AddressGoneAwayDate__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Store_new_Address</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_new_Address</name>
        <label>Store new Address</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.GiftAidClaimableAddress__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>newAddressAsJSON</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Commit_Contact</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>1. If the address changes to empty, the active period must be ended to stop claiming future donations until an address is provided.
2. If an address is provided after a Period has ended due to &quot;gone away&quot; reason, a new period starts with the new address.
3. Otherwise, the new address is stored in the Claimable Address field</description>
        <name>Check_Address_Type</name>
        <label>Check Address Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Store_new_Address</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Address populated</defaultConnectorLabel>
        <rules>
            <name>Blank_empty_Address</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.MailingStreet</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MailingPostalCode</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MailingCity</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MailingState</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MailingCountry</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_Gone_Away_Date</targetReference>
            </connector>
            <label>Blank (empty) Address</label>
        </rules>
        <rules>
            <name>Gone_Away_Populated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AddressGoneAwayDate__c</leftValueReference>
                <operator>HasNoValue</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_new_GA_Period</targetReference>
            </connector>
            <label>Gone Away Populated</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>newAddressAsJSON</name>
        <dataType>String</dataType>
        <expression>IF(
  /* ---------- UK branch ---------- */
  OR(
    ISBLANK({!$Record.MailingCountry}),
    CONTAINS(
      &quot;|UK|U.K.|UNITED KINGDOM|GREAT BRITAIN|GB|GBR|BRITAIN|ENGLAND|SCOTLAND|WALES|NORTHERN IRELAND|&quot;,
      &quot;|&quot; &amp; UPPER(TRIM({!$Record.MailingCountry})) &amp; &quot;|&quot;
    )
  ),
  &quot;{\&quot;House\&quot;:\&quot;&quot; &amp;
    SUBSTITUTE(
      LEFT(
        TRIM(
          IF(
            CONTAINS({!$Record.MailingStreet}, BR()),
            LEFT({!$Record.MailingStreet}, FIND(BR(), {!$Record.MailingStreet}) - 1),
            {!$Record.MailingStreet}
          )
        ),
        40
      ),
      &quot;\&quot;&quot;, &quot;\\\&quot;&quot;
    ) &amp;
  &quot;\&quot;,\&quot;Postcode\&quot;:\&quot;&quot; &amp;
    IF(
      LEN(UPPER(SUBSTITUTE(TRIM({!$Record.MailingPostalCode}), &quot; &quot;, &quot;&quot;))) &gt; 3,
      LEFT(
        UPPER(SUBSTITUTE(TRIM({!$Record.MailingPostalCode}), &quot; &quot;, &quot;&quot;)),
        LEN(UPPER(SUBSTITUTE(TRIM({!$Record.MailingPostalCode}), &quot; &quot;, &quot;&quot;))) - 3
      ) &amp; &quot; &quot; &amp;
      RIGHT(UPPER(SUBSTITUTE(TRIM({!$Record.MailingPostalCode}), &quot; &quot;, &quot;&quot;)), 3),
      UPPER(SUBSTITUTE(TRIM({!$Record.MailingPostalCode}), &quot; &quot;, &quot;&quot;))
    ) &amp;
  &quot;\&quot;}&quot;,

  /* ---------- Non-UK branch ---------- */
  &quot;{\&quot;House name or number\&quot;:\&quot;&quot; &amp;
    SUBSTITUTE(
      LEFT(
        TRIM(
          SUBSTITUTE({!$Record.MailingStreet}, BR(), &quot;, &quot;) &amp;
          IF(ISBLANK({!$Record.MailingCity}), &quot;&quot;, &quot;, &quot; &amp; {!$Record.MailingCity}) &amp;
          IF(ISBLANK({!$Record.MailingPostalCode}), &quot;&quot;, &quot;, &quot; &amp; {!$Record.MailingPostalCode}) &amp;
          IF(ISBLANK({!$Record.MailingCountry}), &quot;&quot;, &quot;, &quot; &amp; {!$Record.MailingCountry})
        ),
        40
      ),
      &quot;\&quot;&quot;, &quot;\\\&quot;&quot;
    ) &amp;
  &quot;\&quot;,\&quot;Postcode\&quot;:\&quot;X\&quot;}&quot;
)</expression>
    </formulas>
    <formulas>
        <name>previousGoneAwayDatePlusOne</name>
        <dataType>Date</dataType>
        <expression>{!$Record.AddressGoneAwayDate__c}+1</expression>
    </formulas>
    <interviewLabel>Gift Aid - Manage Postal Address Changes {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Gift Aid - Manage Postal Address Changes</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_new_GA_Period</name>
        <label>Create new GA Period</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Remove_Gone_Away_Date</targetReference>
        </connector>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StartDate__c</field>
            <value>
                <elementReference>previousGoneAwayDatePlusOne</elementReference>
            </value>
        </inputAssignments>
        <object>GiftAidCoveragePeriod__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Commit_Contact</name>
        <label>Commit Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>End_Active_GA_Periods</name>
        <label>End Active GA Periods</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Commit_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EndDate__c</field>
            <operator>EqualTo</operator>
        </filters>
        <inputAssignments>
            <field>EndDate__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EndReason__c</field>
            <value>
                <stringValue>Gone Away</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Gift_Aid_Coverage_Periods__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>or</filterLogic>
        <filters>
            <field>MailingStreet</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>MailingPostalCode</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>MailingCity</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>MailingState</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>MailingCountry</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Check_Address_Type</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
